# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- App ---
APP_ENV=development
APP_NAME=HireLens AI
API_V1_PREFIX=/api/v1
DEBUG=true

# --- Database (Supabase Postgres connection string) ---
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Find it in Supabase dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:password@localhost:5432/hirelens

# --- Supabase (storage + project API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key
SUPABASE_STORAGE_BUCKET=candidate-documents

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Generative AI (Gemini) ---
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-api-key
LLM_MODEL_NAME=gemini-3.5-flash

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Public intake bridge (Google Form -> Apps Script -> POST /public/apply) ---
# Leave blank to disable the endpoint (it 503s). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PUBLIC_APPLY_API_KEY=
